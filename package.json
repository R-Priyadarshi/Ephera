{
  "name": "ephera",
  "private": true,
  "devDependencies": {
    "playwright": "^1.55.0",
    "playwright-core": "^1.55.0"
  },
  "scripts": {
    "postinstall": "npm --prefix server install",
    "dev": "node dev.js",
    "dev:secure": "node dev-secure.js",
    "start": "node server/serve.js",
    "scan": "node scripts/zero-memory-scan.cjs",
    "test:server:fuzz": "node server/test/signaling.fuzz.test.js",
    "test:server:fuzz-heavy": "SIGNALING_FUZZ_PROFILE=heavy node server/test/signaling.fuzz.test.js",
    "test:server": "node server/test/run-all.js",
    "test:server:stress-heavy": "SIGNALING_STRESS_PROFILE=heavy SIGNALING_FUZZ_PROFILE=heavy node server/test/run-all.js",
    "test": "node --expose-gc client/test/run-all.js && npm run test:server",
    "verify": "npm test && npm run e2e",
    "e2e": "node e2e/webrtc-app.e2e.cjs",
    "e2e:fast": "E2E_FAST=1 node e2e/webrtc-app.e2e.cjs",
    "e2e:remote": "E2E_REMOTE=1 node e2e/webrtc-app.e2e.cjs",
    "e2e:remote:fast": "E2E_REMOTE=1 E2E_FAST=1 node e2e/webrtc-app.e2e.cjs",
    "e2e:staging-smoke": "node e2e/staging-smoke.cjs",
    "e2e:relay": "E2E_RELAY_RUNTIME=1 node e2e/webrtc-app.e2e.cjs",
    "e2e:relay:required": "E2E_RELAY_RUNTIME=1 E2E_RELAY_REQUIRED=1 node e2e/webrtc-app.e2e.cjs",
    "e2e:perf": "E2E_PERF=1 node e2e/webrtc-app.e2e.cjs",
    "e2e:soak": "E2E_SOAK=1 node e2e/webrtc-app.e2e.cjs",
    "perf": "npm test && npm run e2e:perf",
    "gates": "npm run scan && npm run perf && npm run e2e:soak",
    "gates:full": "npm run gates && npm run e2e:relay:required",
    "gates:relay-local": "node scripts/relay-gate-local.cjs"
  }
}
